{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gointegrity:schema:check-request:v1",
  "title": "gointegrity check request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "checks"],
  "properties": {
    "schema": {
      "const": "gointegrity/check-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "returns_error_on_invalid_input",
              "dataflow_reaches",
              "param_used",
              "no_placeholder",
              "reachable_from",
              "not_reachable",
              "calls",
              "never_calls",
              "returns_nonzero",
              "pattern"
            ]
          },
          "description": { "type": "string" },
          "target": {},
          "params": { "type": "object", "additionalProperties": true },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": { "type": "string", "enum": ["holds", "violated"] },
              "quantifier": { "type": "string", "enum": ["all", "any"] },
              "min_targets": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
